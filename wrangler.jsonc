{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osu-thumbnailer-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    "ALLOWED_ORIGIN": "https://purnac501.github.io"
  },
  "analytics_engine_datasets": [
    {
      "binding": "REQUEST_ANALYTICS",
      "dataset": "osu_thumbnailer_requests"
    }
  ],
  "ratelimits": [
    {
      "name": "SCORE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "OSU_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["OSU_CLIENT_ID", "OSU_CLIENT_SECRET"]
  }
}
