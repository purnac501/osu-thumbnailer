{
  "name": "osu-thumbnailer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wrangler dev --port 8788 --env-file .env\"",
    "dev:api": "wrangler dev --port 8788 --env-file .env",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "template:compare": "tsx scripts/template-compare.ts",
    "render:matrix": "tsx scripts/render-matrix.ts",
    "generate": "tsx scripts/generate.ts",
    "serve:static": "vite build && tsx src/server/index.ts --serve-static",
    "deploy:api": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.0.0",
    "@fontsource/montserrat": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "flag-icons": "^7.2.3",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-colorful": "^5.8.0",
    "react-dom": "^18.3.1",
    "react-rnd": "^10.5.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.45.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^2.0.2",
    "wrangler": "^4.127.1"
  }
}
