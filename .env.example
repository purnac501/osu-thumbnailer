# osu! API v2 credentials (https://osu.ppy.sh/home/account/edit -> OAuth)
# Used by the local Cloudflare Worker. Add the same values as Worker secrets in production.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Restrict production API calls to your GitHub Pages origin.
ALLOWED_ORIGIN=http://localhost:5173

# Set this during the GitHub Pages build to the deployed Worker URL.
VITE_API_BASE_URL=
